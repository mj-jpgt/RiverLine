# RiverLine SDD — production environment template.
#
# Copy to `.env.production` (never committed — see .gitignore) and fill in
# real values. Used by `docker compose -f docker-compose.prod.yml --env-file
# .env.production up -d`. Full walkthrough: docs/deploy/self-host.md.

# ---------------------------------------------------------------------------
# Postgres (db service, docker-compose.prod.yml). SECRET.
# ---------------------------------------------------------------------------
# Database role the app and migrations connect as. Pick your own values —
# these are not defaults baked into the image, docker-compose.prod.yml
# requires them (`:?` fails the compose run if unset).
POSTGRES_USER=riverline
POSTGRES_PASSWORD=
POSTGRES_DB=riverline

# ---------------------------------------------------------------------------
# App (app service). SECRET.
# ---------------------------------------------------------------------------
# HMAC key for signing the session cookie (src/core/auth/session.ts) — must
# be at least 32 chars. Generate one per environment; never reuse the value
# from .env.local/dev, never commit a real value (AGENTS.md rule 9):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Caddy (caddy service, Caddyfile.prod). NOT secret.
# ---------------------------------------------------------------------------
# The public hostname Caddy serves and requests a real Let's Encrypt
# certificate for. Requires that hostname's DNS to point at this host and
# ports 80+443 reachable from the internet (ACME HTTP-01 challenge). Leave
# unset / "localhost" only for local testing — see Caddyfile.prod's header
# comment for what changes (self-signed cert from Caddy's internal CA
# instead of a real one).
SITE_ADDRESS=

# Host ports Caddy binds to. Defaults (80/443) are correct for a real
# deployment; override only for local testing when 80/443 are already in
# use on the host.
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------
# KNOWN GAP — production magic-link email delivery (docs/BLOCKERS.md B4)
# ---------------------------------------------------------------------------
# There is currently NO email transport wired up for
# NODE_ENV === 'production'. src/core/auth/magic-link.ts's requestMagicLink()
# throws a loud, explicit error in production rather than silently no-op'ing
# or faking a send — this is deliberate (see AGENTS.md rule 7 and
# docs/BLOCKERS.md B4).
#
# CONCRETELY: with this compose file, as-is, right now, NO ONE CAN LOG IN
# to a production deployment. Every "request sign-in link" submission on
# /login will 500. There is no documented workaround, no dev-only bypass
# available in production (the dev-only route and store are hard-gated off
# whenever NODE_ENV === 'production' — see
# app/api/dev/magic-link/route.ts and src/core/auth/dev-link-store.ts), and
# no environment variable that changes this.
#
# Production login requires B4 to be resolved first: pick a transactional
# email provider (SMTP relay, SES, Postmark, Resend, ...), write the ADR
# AGENTS.md rule 3 requires for the new dependency, and implement the
# production branch of requestMagicLink() against it. Until then, this
# stack is deployable and will pass its healthchecks, but is not usable by
# an official. See docs/BLOCKERS.md B4 for the full steps.
