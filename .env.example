# Local Postgres+PostGIS (docker-compose.yml) — used by `pnpm db:migrate`
# and any local dev/test code that talks to Postgres directly.
DATABASE_URL=postgres://riverline:riverline@localhost:5432/riverline_dev

# M0 auth (src/core/auth). HMAC key for signing the session cookie — must be
# at least 32 chars (enforced in src/core/auth/session.ts). Never commit a
# real value (AGENTS.md rule 9) — generate one per environment (.env.local,
# never committed — see .gitignore) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase (hosted) — required once auth/storage modules are built.
# NEXT_PUBLIC_* vars are exposed to the browser; the service role key never is.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Magic-link email transport (src/core/auth/email-transport.ts,
# docs/adr/0009-email-transport.md, docs/BLOCKERS.md B4).
#
# EMAIL_DRIVER selects how requestMagicLink() delivers the sign-in link:
#   "dev"  — log server-side + stash for app/api/dev/magic-link (the
#            pre-existing dev behavior). Only allowed when NODE_ENV is not
#            "production" — this is enforced in code, not just by unsetting
#            it here.
#   "http" — real send via a provider's plain HTTPS API (see below).
#   "none" — refuse loudly. This is the default when EMAIL_DRIVER is unset
#            AND NODE_ENV=production, so a fresh prod deploy fails loudly
#            instead of silently not sending mail. Leave EMAIL_DRIVER unset
#            in dev/test — it correctly defaults to "dev" there.
EMAIL_DRIVER=

# Required only when EMAIL_DRIVER=http. Recommended provider (ADR 0009):
# Postmark — https://postmarkapp.com/developer/api/email-api. Sign up,
# verify a sending domain (DKIM), then create a Server and grab its Server
# Token (Servers → your server → API Tokens tab).
#   EMAIL_API_URL = https://api.postmarkapp.com/email
#   EMAIL_API_KEY = <your Postmark Server Token — never commit a real one>
#   EMAIL_FROM    = a verified sender address on that Postmark server, e.g.
#                   no-reply@<your-jurisdiction-domain>
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Required whenever EMAIL_DRIVER=http (used to build the absolute
# magic-link URL mailed to a real inbox). Must be an https:// URL when
# NODE_ENV=production — enforced in code.
APP_BASE_URL=
